#!/usr/bin/env bash
# cf — two-letter launcher for the compact-focus ledger editor, meant to be
# typed as `! cf` inside a Claude Code chat (the ! prefix attaches this
# terminal, so the editor takes over the SAME window and q returns to the
# conversation). With arguments, forwards to the instrument script
# (`cf graveyard query drift`, `cf recall D3`, …).
set -u
SCRIPT="$HOME/.claude/skills/compact-focus/scripts/compact-focus-list.sh"
[ -x "$SCRIPT" ] || SCRIPT="$(dirname "$0")/compact-focus-list.sh"
if [ "$#" -eq 0 ]; then
  exec "$SCRIPT" tui
fi
exec "$SCRIPT" "$@"
