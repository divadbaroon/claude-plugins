{
  "description": "Prepare a grounded proposal, review it in a companion terminal, and pass the approved contract into the pending compaction",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/compact-focus\" hook session-start",
            "timeout": 15,
            "statusMessage": "compact focus: restoring the approved contract…",
            "additionalContextLimit": 9000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/compact-focus\" hook precompact",
            "timeout": 3600,
            "statusMessage": "compact focus: waiting for the companion review…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/compact-focus\" hook prepare-dispatch",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/compact-focus\" hook postcompact",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/compact-focus\" hook feedback",
            "timeout": 15,
            "additionalContextLimit": 9000
          }
        ]
      }
    ]
  }
}
