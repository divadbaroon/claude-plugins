{
  "description": "Prepare a grounded proposal, review it inline, and pass the approved contract into the pending compaction",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/compact-focus",
            "args": ["hook", "precompact"],
            "timeout": 3600,
            "statusMessage": "compact focus: preparing the inline review…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/compact-focus",
            "args": ["hook", "prepare"],
            "timeout": 300,
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/compact-focus",
            "args": ["hook", "postcompact"],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/compact-focus",
            "args": ["hook", "feedback"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
