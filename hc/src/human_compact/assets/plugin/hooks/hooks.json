{
  "description": "Chat-scoped goal updates plus opt-in global Vault snapshots.",
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/vault-hook.sh", "args": [] },
        { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh", "args": [], "timeout": 5 }
      ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh", "args": [], "timeout": 5 }
      ] }
    ],
    "UserPromptExpansion": [
      { "matcher": "hc-ui", "hooks": [
        { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh", "args": [], "timeout": 30 }
      ] }
    ],
    "PostToolBatch": [
      { "hooks": [
        { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh", "args": [], "async": true, "timeout": 30 }
      ] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh", "args": [], "async": true, "timeout": 30 }
      ] }
    ],
    "TaskCreated": [
      { "hooks": [
        { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh", "args": [], "async": true, "timeout": 30 }
      ] }
    ],
    "TaskCompleted": [
      { "hooks": [
        { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh", "args": [], "async": true, "timeout": 30 }
      ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/vault-hook.sh", "args": [], "timeout": 20 } ] }
    ],
    "PostCompact": [
      { "hooks": [
        { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/vault-hook.sh", "args": [] },
        { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh", "args": [], "async": true, "timeout": 30 }
      ] }
    ],
    "SessionEnd": [
      { "hooks": [
        { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/vault-hook.sh", "args": [], "timeout": 15 },
        { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh", "args": [], "timeout": 5 }
      ] }
    ]
  }
}
