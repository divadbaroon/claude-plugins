{
  "description": "Chat-scoped goal updates for /goals-ui.",
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh\"", "args": [], "timeout": 5 }
      ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh\"", "args": [], "timeout": 5 }
      ] }
    ],
    "UserPromptExpansion": [
      { "matcher": "goals-ui", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh\"", "args": [], "timeout": 45 }
      ] }
    ],
    "PostToolBatch": [
      { "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh\"", "args": [], "async": true, "timeout": 30 },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh\" --inject-only", "args": [], "timeout": 5 }
      ] }
    ],
    "SubagentStart": [
      { "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh\" --inject-only", "args": [], "timeout": 5 }
      ] }
    ],
    "SubagentStop": [
      { "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh\"", "args": [], "async": true, "timeout": 30 }
      ] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh\"", "args": [], "async": true, "timeout": 30 }
      ] }
    ],
    "TaskCreated": [
      { "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh\"", "args": [], "async": true, "timeout": 30 }
      ] }
    ],
    "TaskCompleted": [
      { "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh\"", "args": [], "async": true, "timeout": 30 }
      ] }
    ],
    "PostCompact": [
      { "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh\"", "args": [], "async": true, "timeout": 30 }
      ] }
    ],
    "SessionEnd": [
      { "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/chat-hook.sh\"", "args": [], "timeout": 5 }
      ] }
    ]
  }
}
